# Server Configuration
SERVER_PORT=8081

# Database Configuration (PostgreSQL - Supabase)
DB_URL=jdbc:postgresql://your-supabase-host:5432/your-database
DB_USERNAME=your-username
DB_PASSWORD=your-password

# AI Configuration
# Options: mock (for development without API tokens) or groq (for production)
AI_MODE=mock

# Groq AI Configuration (only required when AI_MODE=groq)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# JWT Configuration
# Generate a secure random string (at least 256 bits / 32 characters)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_for_security

# Razorpay Configuration
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use test keys for development (rzp_test_xxx)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
