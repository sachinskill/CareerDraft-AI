# Server Port
SERVER_PORT=8081

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://your-supabase-host:5432/your-database
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# AI Mode (mock or groq)
# Set to mock to bypass external Groq calls during local offline development
AI_MODE=mock
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Python ATS Microservice (Optional fallback endpoint)
ATS_PYTHON_URL=http://localhost:8000

# Security Settings
# Make sure to use a secure 256-bit key in production
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_for_security

# Cookie Directives
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Cross-Origin Policies (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Resend Email Integration (Optional)
# Emails are skipped gracefully during dev if left blank or containing placeholder keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Frontend callback target URL
FRONTEND_URL=http://localhost:5173

# Razorpay Configuration (Required - Spring Context will crash if empty or missing)
# Use sandbox test keys (rzp_test_xxx) for local testing
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
