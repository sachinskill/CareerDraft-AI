# ─────────────────────────────────────────────────────────────────────────────
# AI Resume Builder — Backend Environment Variables
# Copy this file to .env and fill in real values for local development.
# For production (Render): set these in the Render dashboard → Environment tab.
# ─────────────────────────────────────────────────────────────────────────────

# Server port (Render injects PORT automatically — do NOT set this on Render)
SERVER_PORT=8081

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Use the Transaction Pooler URL from Supabase → Project Settings → Database → Connection string
# Format: jdbc:postgresql://<host>:5432/<db>?sslmode=require
DB_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password

# ── AI Service ────────────────────────────────────────────────────────────────
# Options: groq (production) | mock (no API key needed, returns dummy data)
AI_MODE=groq

# Get your key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Must be at least 32 characters. Keep this secret — changing it invalidates all sessions.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ── Cookie (cross-origin Vercel → Render setup) ───────────────────────────────
# MUST be true in production — Render serves over HTTPS, and SameSite=None requires Secure.
COOKIE_SECURE=true
# Leave blank for cross-origin deployments (Vercel frontend ↔ Render backend).
# Only set a domain value if frontend and backend share the same parent domain.
COOKIE_DOMAIN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes, no spaces).
# Add your exact Vercel deployment URL here.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# ── Frontend URL (used in email links) ────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_xxx) for dev, live keys for production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Get webhook secret from Razorpay dashboard → Webhooks → your webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified sender domain in Resend (or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Python ATS Microservice ───────────────────────────────────────────────────
# If you deploy ats-python-service separately, set its URL here.
# Leave blank to use the Java fallback scorer (still gives good results).
ATS_PYTHON_URL=
